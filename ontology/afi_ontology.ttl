# Services : l'APII reçoit la « Déclaration de création d'un projet industriel ou de services »
# (afi.chatbot_connaissances, fiche 42) ; pour l'orientation, ce sont les « autres secteurs » de la règle APII.
# Les services liés à l'agriculture (vétérinaires…) restent reconnus comme agriculture quand le texte le dit.
id:secteur-services a afi:Secteur ;
    afi:codeSecteur "services" ;
    skos:prefLabel "Services"@fr, "خدمات"@ar ;
    dcterms:source "Fiche 42 de afi.chatbot_connaissances : « Déclaration de création d'un projet industriel ou de services auprès de l'APII »." ;
    skos:altLabel "services"@fr, "prestation de services"@fr, "société de services"@fr, "logiciel"@fr, "logiciels"@fr,
        "informatique"@fr, "développement de logiciels"@fr, "centre d'appels"@fr, "bureau d'études"@fr,
        "services"@en, "software"@en, "it services"@en, "call center"@en, "consulting"@en,
        "dienstleistung"@de, "dienstleistungen"@de, "softwareentwicklung"@de,
        "hizmet"@tr, "hizmetler"@tr, "yazılım"@tr,
        "خدمات"@ar, "برمجيات"@ar, "إعلامية"@ar, "مركز نداء"@ar, "مكتب دراسات"@ar,
        "khadamet"@ar-Latn-TN, "informatique"@ar-Latn-TN, "logiciel"@ar-Latn-TN .

# ---------------------------------------------------------------------
# Démarches administratives (famille « Démarche » du cahier §IV.5 : « Base de connaissances,
# fiches SICAD »). Schéma et vocabulaire seulement : les démarches, leurs organismes et leurs
# domaines sont construits depuis PostgreSQL (assistant.demarches_externes, fiches SICAD de
# afi.chatbot_sources) par backend/app/semantique/graphe_demarches.py.
# Un domaine est relié aux fiches par son libellé SICAD exact (afi:libelleSicad, comparé sans
# accents ni casse). Les synonymes ont été saisis par l'équipe le 2026-11-27 : ils servent à
# reconnaître le besoin dans une question, pas à décider quelle démarche s'applique.
# ---------------------------------------------------------------------

afi:Demarche a owl:Class ;
    rdfs:label "Démarche"@fr, "Procedure"@en, "إجراء"@ar .

afi:DemarcheAdministrative a owl:Class ;
    rdfs:subClassOf afi:Demarche ;
    rdfs:label "Démarche administrative (fiche SICAD)"@fr, "Administrative procedure"@en, "إجراء إداري"@ar ;
    rdfs:comment "Fiche du portail SICAD ; texte dans assistant.document_versions (type fiche_sicad)."@fr .

afi:ServiceAFI rdfs:subClassOf afi:Demarche .

afi:DomaineDemarche a owl:Class ;
    rdfs:label "Domaine de démarche (SICAD)"@fr, "Procedure domain"@en .

afi:relevePar a owl:ObjectProperty ;
    rdfs:comment "Ministère ou organisme cité par la fiche (jamais déduit)."@fr ;
    rdfs:domain afi:Demarche ;
    rdfs:range afi:Organisme .

afi:dansDomaine a owl:ObjectProperty ;
    rdfs:domain afi:Demarche ;
    rdfs:range afi:DomaineDemarche .

afi:libelleSicad a owl:DatatypeProperty ;
    rdfs:comment "Libellé exact du domaine sur SICAD (« Secteurs & Domaines »)."@fr ;
    rdfs:domain afi:DomaineDemarche ;
    rdfs:range xsd:string .

afi:typeFiche a owl:DatatypeProperty ;
    rdfs:comment "prestation (conditions, pièces, étapes, délai) ou cahier_des_charges (activité soumise à un cahier des charges)."@fr ;
    rdfs:domain afi:DemarcheAdministrative ;
    rdfs:range xsd:string .

afi:secteurSicad a owl:DatatypeProperty ;
    rdfs:domain afi:DemarcheAdministrative ;
    rdfs:range xsd:string .

