id:service-copie-conforme a afi:ServiceAFI ;
    afi:code "copie_conforme" ;
    afi:ficheConnaissance 22 ;
    skos:altLabel "copie conforme"@fr, "copie"@fr, "duplicata"@fr,
        "copy"@en, "kopie"@de, "kopya"@tr,
        "نسخة مطابقة"@ar, "نسخة"@ar,
        "noskha mtabe9a"@ar-Latn-TN, "nos5a mtabe9a"@ar-Latn-TN, "noskha motabi9a"@ar-Latn-TN .

# ---------------------------------------------------------------------
# Vocabulaire des démarches (repère des phrases dans les fiches publiées)
# ---------------------------------------------------------------------

id:lieu-depot a skos:Concept ;
    skos:prefLabel "lieu de dépôt"@fr ;
    rdfs:comment "Expressions qui, dans une fiche de service, disent OÙ déposer la demande. « Bureau d'accueil » n'en fait pas partie : la page l'indique comme lieu où le formulaire est disponible."@fr ;
    skos:altLabel "bureau d'ordre central"@fr, "bureau d'enregistrement central"@fr,
        "déposée au gouvernorat"@fr, "déposé auprès du gouvernorat"@fr,
        "central control office"@en, "central registration office"@en,
        "مكتب الضبط المركزي"@ar, "بالولاية مرجع النظر"@ar .

id:frais a skos:Concept ;
    skos:prefLabel "frais"@fr ;
    rdfs:comment "Mots qui signalent un paiement dans une fiche ; une ligne qui en contient sans montant en dinars donne l'avertissement frais_non_chiffres."@fr ;
    skos:altLabel "frais"@fr, "prix du lot"@fr, "redevance"@fr, "quittance"@fr,
        "fees"@en, "معلوم"@ar, "معاليم"@ar .
