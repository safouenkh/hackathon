# Ontologie de Dalila (AFI) : famille « Service de l'AFI » et vocabulaire des démarches.
#
# - Les services, leurs parcours et leur contenu sont dans PostgreSQL (schéma `assistant`) ;
#   ce graphe garde seulement les codes, les synonymes par langue et les liens stables
#   (AFI_Pipeline_Architecture.md §8, cahier des charges BF16, BF17 et BNF19).
# - Les synonymes de ce fichier ont été saisis par l'équipe le 2026-11-27 (arabizi complété après un essai en conditions réelles) : ils ne viennent
#   pas d'une source de l'AFI et seront enrichis par l'apprentissage contrôlé (BF18).
# - Les numéros de fiches renvoient à afi.chatbot_connaissances (cahier §IV.6, colonne
#   « Fiches existantes » ; la fiche 12 est une ancienne version des fiches 13 et 14).
# - URI de démonstration (architecture §7) : à remplacer par un espace de noms stable avant production.

@prefix afi:     <https://example.org/afi/ontology#> .
@prefix id:      <https://example.org/afi/resource/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/afi/ontology> a owl:Ontology ;
    rdfs:label "Ontologie de Dalila (AFI)"@fr ;
    owl:versionInfo "0.1.0" ;
    dcterms:created "2026-11-27"^^xsd:date ;
    dcterms:creator "Équipe Dalila (hackathon Agentic AFI)" .

# ---------------------------------------------------------------------
# Classes et propriétés
# ---------------------------------------------------------------------

afi:ServiceAFI a owl:Class ;
    rdfs:label "Service de l'AFI"@fr, "AFI service"@en, "خدمة الوكالة العقارية الصناعية"@ar .

afi:Organisme a owl:Class ;
    rdfs:label "Organisme"@fr, "Organisation"@en .

afi:code a owl:DatatypeProperty ;
    rdfs:comment "Code du service dans assistant.services.code."@fr ;
    rdfs:domain afi:ServiceAFI ;
    rdfs:range xsd:string .

afi:ficheConnaissance a owl:DatatypeProperty ;
    rdfs:comment "Identifiant d'une fiche de afi.chatbot_connaissances (réponses validées par l'AFI)."@fr ;
    rdfs:range xsd:integer .

afi:fichePresentation a owl:DatatypeProperty ;
    rdfs:subPropertyOf afi:ficheConnaissance ;
    rdfs:comment "Fiche à montrer au début du guidage, car elle explique le service mieux que la page source."@fr ;
    rdfs:range xsd:integer .

afi:ficheContact a owl:DatatypeProperty ;
    rdfs:comment "Fiche de afi.chatbot_connaissances qui donne le contact de l'organisme."@fr ;
    rdfs:domain afi:Organisme ;
    rdfs:range xsd:integer .

afi:exigeStatutLot a owl:DatatypeProperty ;
    rdfs:comment "Statut que doit avoir un lot pour ce service (valeur de StatutLot)."@fr ;
    rdfs:domain afi:ServiceAFI ;
    rdfs:range xsd:string .

afi:serviceDuStatutLot a owl:DatatypeProperty ;
    rdfs:comment "Statut de lot (valeur de StatutLot) qui oriente vers ce service."@fr ;
    rdfs:domain afi:ServiceAFI ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------
# Zones industrielles et cahiers des charges (famille « Zone » du cahier BF16)
# Schéma seulement : les instances (zones, cahiers, passages, catégories) sont construites
# depuis PostgreSQL au démarrage (backend/app/semantique/graphe_zones.py). Le graphe ne garde
# que des identifiants et des relations stables ; prix, surfaces et statuts restent en SQL.
# Repris du paquet GraphRAG de l'équipe (IndustrialZone, SpecificationDocument, Chunk,
# LandUseCategory), noms en français pour rester cohérent avec ce fichier.
# ---------------------------------------------------------------------

afi:ZoneIndustrielle a owl:Class ;
    rdfs:label "Zone industrielle"@fr, "Industrial zone"@en, "منطقة صناعية"@ar .

afi:CahierDesCharges a owl:Class ;
    rdfs:label "Cahier des charges"@fr, "Specification document"@en, "كراس الشروط"@ar ;
    rdfs:comment "Règlement d'une zone ; document dans assistant.documents (type cahier_charges)."@fr .

afi:Passage a owl:Class ;
    rdfs:label "Passage de document"@fr, "Document chunk"@en ;
    rdfs:comment "Le texte exact est dans assistant.document_chunks ; Qdrant utilise le même UUID."@fr .

afi:CategorieUsageSol a owl:Class ;
    rdfs:label "Catégorie d'usage du sol"@fr, "Land-use category"@en ;
    rdfs:comment "Code défini par UN cahier : « UIB » de Korba et « UIB » de Jelma sont deux catégories différentes."@fr .

afi:codeZone a owl:DatatypeProperty ;
    rdfs:comment "afi.zones.code_zone."@fr ;
    rdfs:domain afi:ZoneIndustrielle ;
    rdfs:range xsd:integer .

afi:aPourCahier a owl:ObjectProperty ;
    rdfs:comment "Lien venu de la table AFI afi.zone_documents (jamais deviné)."@fr ;
    rdfs:domain afi:ZoneIndustrielle ;
    rdfs:range afi:CahierDesCharges .

afi:aPourPassage a owl:ObjectProperty ;
    rdfs:domain afi:CahierDesCharges ;
    rdfs:range afi:Passage .

afi:passageSuivant a owl:ObjectProperty ;
    rdfs:domain afi:Passage ;
    rdfs:range afi:Passage .

afi:definitCategorie a owl:ObjectProperty ;
    rdfs:domain afi:CahierDesCharges ;
    rdfs:range afi:CategorieUsageSol .

afi:concerneCategorie a owl:ObjectProperty ;
    rdfs:comment "Le passage ne s'applique qu'à cette catégorie de son cahier."@fr ;
    rdfs:domain afi:Passage ;
    rdfs:range afi:CategorieUsageSol .

afi:codeCategorie a owl:DatatypeProperty ;
    rdfs:domain afi:CategorieUsageSol ;
    rdfs:range xsd:string .

afi:identifiantDocument a owl:DatatypeProperty ;
    rdfs:comment "assistant.documents.id."@fr ;
    rdfs:range xsd:integer .

afi:identifiantVersion a owl:DatatypeProperty ;
    rdfs:comment "assistant.document_versions.id (version lue)."@fr ;
    rdfs:range xsd:integer .

afi:identifiantPassage a owl:DatatypeProperty ;
    rdfs:comment "assistant.document_chunks.id (UUID), identique à l'identifiant du point Qdrant."@fr ;
    rdfs:domain afi:Passage ;
    rdfs:range xsd:string .

afi:numeroArticle a owl:DatatypeProperty ;
    rdfs:domain afi:Passage ;
    rdfs:range xsd:string .

# ---------------------------------------------------------------------
# Secteurs d'activité (famille « Secteur » du cahier BF16)
# Codes utilisés par assistant.regles_orientation (secteur, secteur_exclu). Les synonymes ont été
# saisis par l'équipe le 2026-11-27 : ils servent à reconnaître le secteur dans une question, pas à
# décider de l'éligibilité (ce sont les règles sourcées qui orientent).
# « agroalimentaire » n'est volontairement rattaché à aucun secteur : l'APII le classe dans
# l'industrie (« Industries agro-alimentaires ») et l'APIA traite la « première transformation ».
# ---------------------------------------------------------------------

afi:Secteur a owl:Class ;
    rdfs:label "Secteur d'activité"@fr, "Sector"@en, "قطاع"@ar .

afi:codeSecteur a owl:DatatypeProperty ;
    rdfs:domain afi:Secteur ;
    rdfs:range xsd:string .

id:secteur-agriculture a afi:Secteur ;
    afi:codeSecteur "agriculture" ;
    skos:prefLabel "Agriculture"@fr, "فلاحة"@ar ;
    skos:altLabel "agriculture"@fr, "agricole"@fr, "agriculteur"@fr, "exploitation agricole"@fr, "ferme"@fr,
        "élevage"@fr, "production végétale"@fr, "production animale"@fr, "arboriculture"@fr, "maraîchage"@fr,
        "agriculture"@en, "farming"@en, "farm"@en, "livestock"@en,
        "landwirtschaft"@de, "tarım"@tr, "çiftlik"@tr,
        "فلاحة"@ar, "فلاحي"@ar, "زراعة"@ar, "زراعي"@ar, "تربية الماشية"@ar,
        "fla7a"@ar-Latn-TN, "fle7a"@ar-Latn-TN, "filaha"@ar-Latn-TN, "fellah"@ar-Latn-TN, "zra3a"@ar-Latn-TN .

id:secteur-peche a afi:Secteur ;
    afi:codeSecteur "peche" ;
    skos:prefLabel "Pêche et aquaculture"@fr, "صيد بحري"@ar ;
    skos:altLabel "pêche"@fr, "pêcheur"@fr, "aquaculture"@fr, "pisciculture"@fr,
        "fishing"@en, "fishery"@en, "aquaculture"@en, "fischerei"@de, "balıkçılık"@tr,
        "صيد بحري"@ar, "الصيد البحري"@ar, "تربية الأسماك"@ar, "تربية الأحياء المائية"@ar,
        "sayd"@ar-Latn-TN, "sayed"@ar-Latn-TN, "7out"@ar-Latn-TN .

id:secteur-premiere-transformation a afi:Secteur ;
    afi:codeSecteur "premiere_transformation" ;
    skos:prefLabel "Première transformation (agricole)"@fr ;
    skos:altLabel "première transformation"@fr, "1ère transformation"@fr, "transformation des produits agricoles"@fr,
        "first processing"@en, "التحويل الأولي"@ar .

id:secteur-industrie a afi:Secteur ;
    afi:codeSecteur "industrie" ;
    skos:prefLabel "Industrie"@fr, "صناعة"@ar ;
    skos:altLabel "industrie"@fr, "industriel"@fr, "usine"@fr, "manufacture"@fr, "fabrication"@fr,
        "industry"@en, "factory"@en, "manufacturing"@en, "industrie"@de, "fabrik"@de, "sanayi"@tr, "fabrika"@tr,
        "صناعة"@ar, "صناعي"@ar, "مصنع"@ar, "sina3a"@ar-Latn-TN, "msna3"@ar-Latn-TN, "usine"@ar-Latn-TN .

# ---------------------------------------------------------------------
# L'AFI
# ---------------------------------------------------------------------

id:afi a afi:Organisme ;
    skos:prefLabel "Agence Foncière Industrielle"@fr, "الوكالة العقارية الصناعية"@ar ;
    skos:altLabel "AFI"@fr ;
    afi:ficheContact 26 .

# ---------------------------------------------------------------------
# Les 8 services (cahier §IV.6) ; noms et parcours : assistant.services, assistant.parcours
# ---------------------------------------------------------------------

