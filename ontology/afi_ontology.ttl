    skos:prefLabel "Tunisia Investment Authority"@en ;
    skos:altLabel "TIA"@fr ;
    dcterms:source <https://www.tunisieindustrie.nat.tn/fr/download/IDEES/GUIDE.pdf> .

id:organisme-fipa a afi:Organisme ;
    afi:codeOrganisation "FIPA" ;
    skos:prefLabel "Foreign Investment Promotion Agency"@en ;
    skos:altLabel "FIPA"@fr ;
    dcterms:source <https://www.tunisieindustrie.nat.tn/fr/download/IDEES/GUIDE.pdf> .

id:organisme-ins a afi:Organisme ;
    afi:codeOrganisation "INS" ;
    skos:prefLabel "Institut National de la Statistique"@fr ;
    skos:altLabel "INS"@fr ;
    rdfs:comment "Cité par le cahier « sans lecture automatique » ; le guide APII le donne comme source des statistiques du commerce extérieur (« Source: INS pour l'import et export de la Tunisie »). Aucune page lue."@fr ;
    dcterms:source <https://www.tunisieindustrie.nat.tn/fr/download/IDEES/GUIDE.pdf> .

# ---------------------------------------------------------------------
# L'AFI
