        "craft"@en, "craftsman"@en, "repair"@en, "handwerk"@de, "reparatur"@de, "zanaat"@tr, "tamir"@tr,
        "حرف"@ar, "حرفي"@ar, "صناعات تقليدية"@ar, "إصلاح"@ar .

id:domaine-huiles-usagees a afi:DomaineDemarche ;
    afi:libelleSicad "La gestion des huiles lubrifiantes et des filtres à huiles usagées" ;
    skos:altLabel "huiles usagées"@fr, "huile usagée"@fr, "huiles lubrifiantes"@fr, "huile de vidange"@fr,
        "used oil"@en, "waste oil"@en, "altöl"@de, "atık yağ"@tr, "الزيوت المستعملة"@ar, "زيوت التشحيم"@ar .

id:domaine-environnement-marin a afi:DomaineDemarche ;
    afi:libelleSicad "Protection de l'environnement marin contre la pollution" ;
    skos:altLabel "pollution marine"@fr, "rejet en mer"@fr, "immersion"@fr, "marine pollution"@en,
        "meeresverschmutzung"@de, "deniz kirliliği"@tr, "التلوث البحري"@ar .

id:domaine-environnement-urbain a afi:DomaineDemarche ;
    afi:libelleSicad "Protection de l'environnement urbain" ;
    skos:altLabel "parcs urbains"@fr, "parc urbain"@fr, "espaces verts"@fr, "urban park"@en, "المنتزهات الحضرية"@ar .

# Mots qui, dans le TITRE d'une fiche SICAD, signalent une aide ou un avantage (FOPRODEX, FODEP,
# avantages fiscaux) : ces fiches sont aussi rendues par l'outil avantages quand leur domaine est reconnu.
id:incitation-demarche a skos:Concept ;
    skos:prefLabel "titre annonçant une aide"@fr ;
    rdfs:comment "Sert aussi à reconnaître les instances de afi:Incitation (titres des pages des organismes)."@fr ;
    skos:altLabel "avantages"@fr, "avantage"@fr, "indemnités"@fr, "concours du fonds"@fr, "prime"@fr, "primes"@fr,
        "subvention"@fr, "subventions"@fr, "incitations"@fr, "incitation"@fr, "prêts fonciers"@fr,
        "franchise douanière"@fr, "financement"@fr, "package d'incitations"@fr .

id:domaine-cahiers-des-charges a afi:DomaineDemarche ;
    afi:libelleSicad "Prestations soumises au régime des cahiers des charges" ;
    rdfs:comment "Pas de synonyme : « cahier des charges » désigne aussi le règlement d'une zone (outil regles_zone)."@fr .

# ---------------------------------------------------------------------
# Lieu, Lot, Commodité, Incitation, Projet (familles du cahier §IV.5)
# Schéma seulement : les instances sont construites depuis PostgreSQL et les données de référence
# sourcées (backend/app/semantique/graphe_familles.py). Le graphe garde des identifiants et des liens :
# prix, statuts, surfaces et distances restent en SQL.
# ---------------------------------------------------------------------

afi:Lieu a owl:Class ;
    rdfs:label "Lieu"@fr, "Place"@en, "مكان"@ar .

afi:ZoneIndustrielle rdfs:subClassOf afi:Lieu .

afi:Gouvernorat a owl:Class ;
    rdfs:subClassOf afi:Lieu ;
    rdfs:label "Gouvernorat"@fr, "Governorate"@en, "ولاية"@ar ;
    rdfs:comment "Codes zones.gouv_id ; noms relevés sur liste.php (backend/app/processing/reference.py)."@fr .

afi:codeGouvernorat a owl:DatatypeProperty ;
    rdfs:domain afi:Gouvernorat ;
    rdfs:range xsd:integer .

afi:gouvernoratDeduit a owl:DatatypeProperty ;
    rdfs:comment "Correspondance déduite (non lue sur le site) : à confirmer par l'AFI."@fr ;
    rdfs:domain afi:Gouvernorat ;
    rdfs:range xsd:boolean .

afi:dansGouvernorat a owl:ObjectProperty ;
    rdfs:comment "Lien venu de zones.gouv_id (jamais deviné)."@fr ;
    rdfs:range afi:Gouvernorat .

afi:Lot a owl:Class ;
    rdfs:label "Lot industriel"@fr, "Industrial plot"@en, "مقسم صناعي"@ar ;
    rdfs:comment "Seulement l'identifiant et la zone : surface, prix et statut restent dans afi.lots."@fr .

afi:identifiantLot a owl:DatatypeProperty ;
    rdfs:comment "afi.lots.lot_id."@fr ;
    rdfs:domain afi:Lot ;
    rdfs:range xsd:integer .

afi:dansZone a owl:ObjectProperty ;
    rdfs:comment "Lien venu de lots.zone_id ; un lot orphelin (zone absente de afi.zones) n'en a pas."@fr ;
    rdfs:domain afi:Lot ;
    rdfs:range afi:ZoneIndustrielle .

afi:lotOrphelin a owl:DatatypeProperty ;
    rdfs:domain afi:Lot ;
    rdfs:range xsd:boolean .

afi:TypeCommodite a owl:Class ;
    rdfs:label "Commodité"@fr, "Amenity"@en, "مرفق"@ar ;
    rdfs:comment "Types com_id de la carte publique (/data/zone-commodites.php, lu le 26/11/2026)."@fr .

afi:codeCommodite a owl:DatatypeProperty ;
    rdfs:domain afi:TypeCommodite ;
    rdfs:range xsd:integer .

afi:aProximiteDe a owl:ObjectProperty ;
    rdfs:comment "La zone a une distance renseignée (en km) vers ce type d'équipement dans afi.zone_commodites ; la distance reste en SQL."@fr ;
    rdfs:domain afi:ZoneIndustrielle ;
    rdfs:range afi:TypeCommodite .

afi:Incitation a owl:Class ;
    rdfs:label "Incitation"@fr, "Incentive"@en, "حافز"@ar ;
    rdfs:comment "Page d'un organisme ou fiche SICAD dont le titre annonce une aide (vocabulaire id:incitation-demarche) ; le texte est dans PostgreSQL et Qdrant."@fr .

afi:accordeePar a owl:ObjectProperty ;
    rdfs:domain afi:Incitation ;
    rdfs:range afi:Organisme .

afi:octroieAvantagesPour a owl:ObjectProperty ;
    rdfs:comment "Règle sourcée de assistant.regles_orientation (rôle octroi_avantages, phrase exacte contrôlée par la base)."@fr ;
    rdfs:domain afi:Organisme ;
    rdfs:range afi:Secteur .

afi:codeOrganisation a owl:DatatypeProperty ;
    rdfs:comment "Code utilisé par assistant.sources.organisation et assistant.regles_orientation."@fr ;
    rdfs:domain afi:Organisme ;
    rdfs:range xsd:string .

afi:Projet a owl:Class ;
    rdfs:label "Projet d'investissement"@fr, "Investment project"@en, "مشروع استثماري"@ar ;
    rdfs:comment "Projet décrit par l'investisseur dans la conversation (schéma Projet de preparer_demande) ; jamais enregistré dans le graphe. Les listes QualificationProjet et ConseilProjet::NATURES de l'ancienne application n'ont pas été fournies."@fr .

afi:natureProjet a owl:ObjectProperty ;
    rdfs:domain afi:Projet ;
    rdfs:range afi:Secteur .

afi:nombreEmplois a owl:DatatypeProperty ;
    rdfs:domain afi:Projet ;
    rdfs:range xsd:nonNegativeInteger .

afi:investissementDt a owl:DatatypeProperty ;
    rdfs:comment "Coût total du projet en dinars tunisiens."@fr ;
    rdfs:domain afi:Projet ;
    rdfs:range xsd:nonNegativeInteger .

afi:surfaceSouhaiteeM2 a owl:DatatypeProperty ;
    rdfs:domain afi:Projet ;
    rdfs:range xsd:nonNegativeInteger .

afi:localiseDans a owl:ObjectProperty ;
    rdfs:domain afi:Projet ;
    rdfs:range afi:Lieu .

# ---------------------------------------------------------------------
# Organismes cités par le cahier (§IV.5 : « AFI, INS, TIA, APII, APIA, FIPA »). Noms lus dans la liste
# des sigles du guide des idées de projet de l'APII (PDF lu le 2026-11-27) ou sur les pages de l'APII.
# ---------------------------------------------------------------------

id:organisme-apia a afi:Organisme ;
    afi:codeOrganisation "APIA" ;
    skos:prefLabel "Agence de Promotion des Investissements Agricoles"@fr ;
    skos:altLabel "APIA"@fr ;
    dcterms:source <https://www.tunisieindustrie.nat.tn/fr/download/IDEES/GUIDE.pdf> .

id:organisme-apii a afi:Organisme ;
    afi:codeOrganisation "APII" ;
    skos:prefLabel "Agence de Promotion de l'Industrie et de l'Innovation"@fr ;
    skos:altLabel "APII"@fr ;
    dcterms:source <https://www.tunisieindustrie.nat.tn/fr/idee.asp> .

id:organisme-tia a afi:Organisme ;
