afi:ficheEcartee a owl:DatatypeProperty ;
    rdfs:comment "Fiche de afi.chatbot_connaissances jamais proposée par la recherche (raison dans le commentaire de l'organisme)."@fr ;
    rdfs:domain afi:Organisme ;
    rdfs:range xsd:integer .

id:afi a afi:Organisme ;
    skos:prefLabel "Agence Foncière Industrielle"@fr, "الوكالة العقارية الصناعية"@ar ;
    skos:altLabel "AFI"@fr ;
    afi:ficheContact 26 ;
    # 12 : ancienne version des fiches 13 et 14 ; 3 : contact dont les numéros sont écrits à l'envers
    # (« +216 260 124 71 », la fiche 26 donne « +216 71 124 260 ») : le contact vient de la fiche 26.
    afi:ficheEcartee 3, 12 .

