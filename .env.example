# Copier en .env et remplacer les valeurs. Ne jamais committer .env.

# PostgreSQL local (docker compose)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dalila

# Propriétaire de la base : sert uniquement à l'import du dump et aux migrations
POSTGRES_ADMIN_USER=dalila_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin

# Rôle en lecture seule utilisé par le backend (créé par scripts/import_afi_dump.py)
POSTGRES_RO_USER=dalila_ro
POSTGRES_RO_PASSWORD=change-me-ro

# Banc de test LLM (facultatif) : clé Gemini créée sur Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Interface web du banc sur /banc (outil de développement : ne jamais activer en production)
BANC_LLM_ACTIF=false

# Chemin du dump MariaDB fourni par l'AFI (hors Git)
AFI_DUMP_PATH=Chatbot Dalila/Dalila use case 1/afi.sql
